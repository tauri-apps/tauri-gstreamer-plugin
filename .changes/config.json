{
  "gitSiteUrl": "https://www.github.com/tauri-apps/tauri-gstreamer-plugin/",
  "timeout": 3600000,
  "pkgManagers": {
    "rust": {
      "version": true,
      "getPublishedVersion": "node .github/scripts/get-latest-version.js ${ pkgFile.name } ${ pkgFile.version }",
      "publish": [
        {
          "command": "echo 'publish started. libraries will be built in other workflow jobs.'",
          "dryRunCommand": true
        }
      ],
      "postpublish": [
        "git tag ${ pkg.pkg }-v${ pkgFile.versionMajor } -f",
        "git tag ${ pkg.pkg }-v${ pkgFile.versionMajor }.${ pkgFile.versionMinor } -f",
        "git push --tags -f"
      ]
    }
  },
  "packages": {
    "gst-plugin-tauri": {
      "path": "./",
      "manager": "rust"
    }
  }
}
